# Puerto HTTP de la app (por defecto 3011; el backend_manual usa 3010).
PORT=3011

# Motor activo: mysql | postgres | mssql | oracle
# Solo se valida y se usa el bloque DB_<MOTOR>_* correspondiente a este valor.
DB_DIALECT=mysql

# --- MySQL (contenedor nc-mysql, ver ../databases_engines) ---
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=
DB_MYSQL_NAME=norte_creativo_ia

# --- PostgreSQL (contenedor nc-postgres, puerto host 5433) ---
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5433
DB_POSTGRES_USERNAME=nc_admin
DB_POSTGRES_PASSWORD=
DB_POSTGRES_NAME=norte_creativo_ia

# --- SQL Server (contenedor nc-sqlserver) ---
DB_MSSQL_HOST=localhost
DB_MSSQL_PORT=1433
DB_MSSQL_USERNAME=sa
DB_MSSQL_PASSWORD=
DB_MSSQL_NAME=norte_creativo_ia

# --- Oracle (contenedor nc-oracle) ---
DB_ORACLE_HOST=localhost
DB_ORACLE_PORT=1521
DB_ORACLE_USERNAME=system
DB_ORACLE_PASSWORD=
DB_ORACLE_NAME=XEPDB1
