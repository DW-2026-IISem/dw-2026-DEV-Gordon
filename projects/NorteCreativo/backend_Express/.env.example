PORT=3012

# Motor activo: mysql | postgres | mssql | oracle
DB_ENGINE=mysql

# --- MySQL (contenedor nc-mysql, ver ../databases_engines) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_NAME=norte_creativo_express
MYSQL_PORT=3306

# --- PostgreSQL (contenedor nc-postgres, puerto host 5433) ---
POSTGRES_HOST=localhost
POSTGRES_USER=nc_admin
POSTGRES_PASSWORD=
POSTGRES_NAME=norte_creativo_express
POSTGRES_PORT=5433

# --- SQL Server (contenedor nc-sqlserver) ---
MSSQL_HOST=localhost
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_NAME=norte_creativo_express
MSSQL_PORT=1433

# --- Oracle (contenedor nc-oracle; ORACLE_NAME es el service name) ---
ORACLE_HOST=localhost
ORACLE_USER=system
ORACLE_PASSWORD=
ORACLE_NAME=XEPDB1
ORACLE_PORT=1521
